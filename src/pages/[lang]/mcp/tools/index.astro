---
import type { MarkdownInstance } from "astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import "@/styles/docs.css";
import AppHeader from "@/components/AppHeader.astro";
import DocsTableOfContents from "@/components/DocsTableOfContents.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCanonicalUrl } from "@/data/seo";
import { languageKeys, locales, siteConfig, type LanguageKey } from "@/data/site";
import mcpSource from "@/generated/mcp/source.json";

export function getStaticPaths() {
    return languageKeys.map((lang) => ({
        params: { lang },
        props: { lang },
    }));
}

type Props = {
    lang: LanguageKey;
};

const { lang } = Astro.props;
const locale = locales[lang];
const pagePath = siteConfig.mcpToolsPath;
const docs = import.meta.glob<MarkdownInstance<Record<string, never>>>(
    "../../../../generated/mcp/tools/*.md",
    { eager: true },
);
const docEntry = Object.entries(docs).find(([path]) => path.endsWith(`/${lang}.md`))?.[1];

if (!docEntry) {
    throw new Error(`Missing MCP tool reference for locale: ${lang}`);
}

const Content = docEntry.Content;
const headings = docEntry.getHeadings().filter(({ depth }) => (
    depth === 2 || depth === 3
));
const documents = [
    {
        current: false,
        href: getRelativeLocaleUrl(lang, siteConfig.mcpDocsPath),
        label: locale.mcpGuideNavigationLabel,
    },
    {
        current: true,
        href: getRelativeLocaleUrl(lang, siteConfig.mcpToolsPath),
        label: locale.mcpToolsNavigationLabel,
    },
];
const pageTitle = `${locale.mcpToolsPageTitle} - ${siteConfig.name}`;
const canonicalUrl = getCanonicalUrl(lang, pagePath);
const techArticleStructuredData = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: locale.mcpToolsPageTitle,
    description: locale.mcpToolsPageDescription,
    inLanguage: locale.htmlLang,
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    about: [
        "ALCOMD3",
        "Model Context Protocol",
        "MCP tools",
        "VRChat project management",
    ],
    author: {
        "@type": "Organization",
        name: siteConfig.authorName,
        url: siteConfig.authorUrl,
    },
    publisher: {
        "@type": "Organization",
        name: siteConfig.authorName,
        url: siteConfig.authorUrl,
    },
};
---

<BaseLayout
    locale={locale}
    pagePath={pagePath}
    title={pageTitle}
    description={locale.mcpToolsPageDescription}
    twitterDescription={locale.mcpToolsPageDescription}
    ogImageAlt={locale.mcpToolsPageTitle}
    structuredData={techArticleStructuredData}
>
    <AppHeader locale={locale} pagePath={pagePath} />
    <main class="docs-page">
        <div class="site-frame">
            <div class="docs-layout">
                <DocsTableOfContents
                    documents={documents}
                    headings={headings}
                    label={locale.mcpDocsTableOfContentsLabel}
                />
                <article class="docs-content">
                    <Content />
                    <footer class="docs-source">
                        <span>{locale.mcpSourceLabel}</span>
                        <a href={mcpSource.sourceUrl} target="_blank">
                            {mcpSource.repository}@{mcpSource.commit.slice(0, 7)}
                        </a>
                    </footer>
                </article>
            </div>
        </div>
    </main>
</BaseLayout>
