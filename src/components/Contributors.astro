---
import { loadGeneratedContributors } from "@/data/contributors.mjs";
import type { LocaleContent } from "@/data/site";

type Props = {
    locale: LocaleContent;
};

const { locale } = Astro.props;
const contributors = await loadGeneratedContributors();
---

{
    contributors.length > 0 && (
        <section
            class="content-section contributors-section"
            data-contributors-section
            aria-labelledby="contributors-title"
        >
            <div class="site-frame narrow-frame">
                <div class="section-heading compact-heading centered-heading">
                    <div>
                        <p class="section-kicker">GitHub</p>
                        <h2 id="contributors-title">{locale.contributorsTitle}</h2>
                    </div>
                </div>
                <div class="contributor-list">
                    {
                        contributors.map((contributor) => (
                            <a
                                class="contributor-link"
                                href={contributor.profileUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                referrerpolicy="no-referrer"
                                aria-label={contributor.name}
                                title={contributor.name}
                                data-contributor-link
                            >
                                <img
                                    src={contributor.avatarUrl}
                                    alt=""
                                    width="56"
                                    height="56"
                                    loading="lazy"
                                    decoding="async"
                                    referrerpolicy="no-referrer"
                                />
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>
    )
}
